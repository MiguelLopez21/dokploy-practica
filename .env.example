# Plantilla de variables de entorno. NO subir el archivo .env real a Git.
# En Dokploy estas variables se escriben en la pestaña "Environment" de la aplicación.
NODE_ENV=production
PORT=3000
APP_NAME=UniQuindioWebApp
APP_VERSION=1.0.0

# MySQL (el host es el "Internal Host" que muestra Dokploy en la pestaña Connection)
DB_HOST=
DB_PORT=3306
DB_NAME=uni_quindio_db
DB_USER=admin_quindio
DB_PASSWORD=

# PostgreSQL
PG_HOST=
PG_PORT=5432
PG_DATABASE=analytics_db
PG_USER=analyst_quindio
PG_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
